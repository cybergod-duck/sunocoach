# Database (Supabase connection pooler recommended)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Redis (Upstash for production)
REDIS_URL=redis://default:[PASSWORD]@[UPSTASH_HOST]:6379

# App
APP_URL=https://sunocoach.YOUR_SUBDOMAIN.workers.dev

# OAuth 2.0
OAUTH_CLIENT_ID=sunocoach-claude
OAUTH_CLIENT_SECRET=your_random_32_char_string_here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...

# Cloudflare KV (get from: wrangler kv namespace list)
KV_NAMESPACE_ID=your_kv_namespace_id_here
